<?xml version="1.0" encoding="UTF-8"?>
<configuration><system.webServer>
  <defaultDocument><files><clear/><add value="index.html"/></files></defaultDocument>
  <security><requestFiltering><hiddenSegments>
    <add segment="data"/><add segment="config.php"/><add segment="config.local.php"/><add segment="configs.js"/><add segment=".env"/><add segment="zoho.php"/><add segment="security.php"/><add segment="mailer.php"/><add segment="seed.json"/><add segment="README-UA.txt"/>
  </hiddenSegments></requestFiltering></security>
</system.webServer></configuration>
